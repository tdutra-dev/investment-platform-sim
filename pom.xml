<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.investmentplatform</groupId>
    <artifactId>investment-platform-sim</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>investment-platform-sim</name>
    <description>Event-driven microservices with Spring Boot, Kafka, Transactional Outbox, MySQL and MongoDB</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- Override Spring Boot 3.3.x default (1.19.8) — supports Docker 29.x API >= 1.44 -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

    <modules>
        <module>outbox-common</module>
        <module>customer-service</module>
        <module>transaction-service</module>
        <module>audit-log-service</module>
        <!-- must stay last: starts the packaged jars of the services above -->
        <module>e2e-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.investmentplatform</groupId>
                <artifactId>outbox-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- docker-java shaded inside testcontainers defaults to API 1.32;
                             Docker 29.x requires minimum 1.44 — set via system property -->
                        <systemPropertyVariables>
                            <api.version>1.44</api.version>
                        </systemPropertyVariables>
                        <!-- Kafka containers need extra time to stop gracefully -->
                        <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <api.version>1.44</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
